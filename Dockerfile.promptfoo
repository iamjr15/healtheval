FROM ghcr.io/promptfoo/promptfoo:0.123.0

USER root

RUN python3 -m venv /opt/healtheval-promptfoo-venv \
    && /opt/healtheval-promptfoo-venv/bin/python -m pip install --no-cache-dir \
        deepeval==2.9.7 \
        python-dotenv \
        pyyaml \
    && chown -R promptfoo:promptfoo /opt/healtheval-promptfoo-venv

USER promptfoo

WORKDIR /workspace

ENV PROMPTFOO_DISABLE_TELEMETRY=1
ENV PROMPTFOO_PYTHON=/opt/healtheval-promptfoo-venv/bin/python
