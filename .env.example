# Copy this file to .env if you want to run live API calls.
# Without .env, the saved dashboard still runs and Live Demo is disabled.

# Optional provider keys for Live Demo and live eval services.
SARVAM_API_KEY=sk-sarvam-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
GOOGLE_API_KEY=AIza-REPLACE_ME

# Optional daily caps in cents. Defaults are safe for local review.
BUDGET_CENTS_PER_DAY_SARVAM_CONVERSATIONS=500
BUDGET_CENTS_PER_DAY_SARVAM_105B=500
BUDGET_CENTS_PER_DAY_CLAUDE_SONNET_46=500
BUDGET_CENTS_PER_DAY_GEMINI_25_PRO=500

# Optional CeRAI endpoint. Only needed for live CeRAI dispatch.
CERAI_BASE_URL=http://localhost:8080

# Optional local dashboard limits.
DAILY_BUDGET_USD=5.00
LIVE_DEMO_RATE_LIMIT_PER_SESSION=5
LIVE_DEMO_MAX_PROMPT_CHARS=1200
HITL_REVIEW_RATE_LIMIT_PER_SESSION=30

# Optional dashboard links.
GITHUB_REPO_URL=https://github.com/iamjr15/healtheval
CLOUDFLARE_LIVE_DEMO_URL=
CLOUDFLARE_HITL_ENDPOINT_URL=

# GEMINI_API_KEY is also accepted; GOOGLE_API_KEY takes precedence.
# HEALTHEVAL_JUDGES optionally selects comma-separated judge model IDs.
